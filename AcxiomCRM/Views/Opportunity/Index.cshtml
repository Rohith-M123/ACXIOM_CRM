@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Management";
    Layout = "_Layout";
    var totalValue = ViewData["TotalValue"] as decimal? ?? 0m;
    var weightedValue = ViewData["WeightedValue"] as decimal? ?? 0m;
}

<div class="container-fluid px-lg-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Sales Opportunities</h1>
            <p class="text-muted small mb-0">Track deals, stages, probabilities, and revenue pipeline projections.</p>
        </div>
        <a asp-action="Create" class="btn btn-amber">
            <i class="bi bi-briefcase-fill me-1"></i>New Opportunity
        </a>
    </div>

    <!-- Pipeline Metric Ribbon -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <span class="text-muted small fw-semibold">TOTAL DEALS IN VIEW</span>
                <div class="h3 fw-bold mb-0 mt-1">@Model.Count()</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="stat-card">
                <span class="text-muted small fw-semibold">AGGREGATE PIPELINE AMOUNT</span>
                <div class="h3 fw-bold text-warning mb-0 mt-1">$@totalValue.ToString("N0")</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="stat-card">
                <span class="text-muted small fw-semibold">WEIGHTED PIPELINE (Amount × Prob)</span>
                <div class="h3 fw-bold text-success mb-0 mt-1">$@weightedValue.ToString("N0")</div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="acxiom-card p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@ViewData["CurrentSearch"]"
                           class="form-control" placeholder="Search opportunity name or customer..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="stage" class="form-select">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(ViewData["CurrentStage"]?.ToString() == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewData["CurrentStage"]?.ToString() == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewData["CurrentStage"]?.ToString() == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewData["CurrentStage"]?.ToString() == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewData["CurrentStage"]?.ToString() == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(ViewData["CurrentStatus"]?.ToString() == "Open")">Open</option>
                    <option value="Won" selected="@(ViewData["CurrentStatus"]?.ToString() == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewData["CurrentStatus"]?.ToString() == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-outline-light w-100">Filter</button>
            </div>
            <div class="col-md-1">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>

    <!-- Opportunities Table -->
    <div class="acxiom-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark-custom align-middle">
                <thead>
                    <tr>
                        <th>Deal Name</th>
                        <th>Account</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No opportunities match current filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-light text-decoration-none">
                                        @o.OpportunityName
                                    </a>
                                </td>
                                <td>
                                    @if (o.Customer != null)
                                    {
                                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@o.Customer.CustomerId" class="text-info text-decoration-none small">
                                            @o.Customer.CustomerName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="fw-bold text-warning">$@o.Amount.ToString("N0")</td>
                                <td>
                                    @if (o.Stage == "Won") { <span class="badge bg-success">Won</span> }
                                    else if (o.Stage == "Lost") { <span class="badge bg-danger">Lost</span> }
                                    else if (o.Stage == "Negotiation") { <span class="badge bg-primary">Negotiation</span> }
                                    else if (o.Stage == "Proposal") { <span class="badge bg-warning text-dark">Proposal</span> }
                                    else { <span class="badge bg-info text-dark">Qualification</span> }
                                </td>
                                <td style="width: 130px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; background-color: #334155;">
                                            <div class="progress-bar bg-warning" role="progressbar" style="width: @o.Probability%;"></div>
                                        </div>
                                        <span class="small text-muted font-monospace">@o.Probability%</span>
                                    </div>
                                </td>
                                <td class="fw-medium text-light">$@o.WeightedAmount.ToString("N0")</td>
                                <td class="small text-muted">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-light" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="FollowUp" asp-action="Create" asp-route-opportunityId="@o.OpportunityId" class="btn btn-outline-info" title="Schedule Follow-up">
                                            <i class="bi bi-calendar-plus"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
