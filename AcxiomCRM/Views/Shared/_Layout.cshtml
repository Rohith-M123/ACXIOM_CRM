<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AcxiomCRM — Customer Relationship Management for modern sales teams" />
    <title>@ViewData["Title"] — AcxiomCRM</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ── Navigation Bar ─────────────────────────────────────── -->
    <nav class="navbar navbar-expand-lg navbar-dark acxiom-navbar shadow-sm">
        <div class="container">
            <!-- Brand -->
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-diagram-3-fill text-warning"></i>
                <span>Acxiom<span class="text-warning">CRM</span></span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain" aria-controls="navbarMain"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill me-1"></i>Admin
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Manager" asp-action="Index">
                                    <i class="bi bi-person-workspace me-1"></i>Manager
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Sales Executive"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Sales" asp-action="Index">
                                    <i class="bi bi-graph-up-arrow me-1"></i>Sales
                                </a>
                            </li>
                        }
                    }
                </ul>

                <!-- Right side: user info / login-logout -->
                <ul class="navbar-nav ms-auto align-items-center gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item d-flex align-items-center me-2">
                            <span class="badge acxiom-role-badge me-2">
                                @if (User.IsInRole("Admin")) { <text><i class="bi bi-shield-fill-check me-1"></i>Admin</text> }
                                else if (User.IsInRole("Manager")) { <text><i class="bi bi-person-check-fill me-1"></i>Manager</text> }
                                else if (User.IsInRole("Sales Executive")) { <text><i class="bi bi-briefcase-fill me-1"></i>Sales Exec</text> }
                                else { <text><i class="bi bi-person-fill me-1"></i>User</text> }
                            </span>
                            <span class="text-light small fw-medium">@User.Identity.Name</span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm fw-semibold" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ── Global Alert Banners ───────────────────────────────── -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- ── Page Content ───────────────────────────────────────── -->
    <main class="pb-5">
        @RenderBody()
    </main>

    <!-- ── Footer ─────────────────────────────────────────────── -->
    <footer class="acxiom-footer py-3 mt-auto">
        <div class="container text-center">
            <small class="text-muted">
                &copy; @DateTime.Now.Year <strong>AcxiomCRM</strong> &mdash; All rights reserved.
                &nbsp;|&nbsp; Phase 1 — Foundation
            </small>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmjPkuSuHWUpbUiOBRMaXFk6RsQ1p"
            crossorigin="anonymous"></script>

    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
