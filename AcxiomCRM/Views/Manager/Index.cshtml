@{
    ViewData["Title"] = "Manager Panel";
    Layout = "_Layout";

    var modules = new[]
    {
        (Icon: "bi-people-fill",          Color: "info",    Title: "Team Overview", Desc: "View and manage your sales team performance."),
        (Icon: "bi-bar-chart-line-fill",  Color: "success", Title: "Sales Reports",  Desc: "Generate and review team sales reports."),
        (Icon: "bi-funnel-fill",          Color: "warning", Title: "Lead Pipeline",  Desc: "Monitor team lead assignments and statuses."),
        (Icon: "bi-calendar3",            Color: "danger",  Title: "Activity Log",   Desc: "Review team activities and follow-up schedules.")
    };
}

<div class="role-header">
    <div class="container">
        <div class="d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:rgba(14,165,233,0.2); width:56px; height:56px; border-radius:14px; flex-shrink:0;">
                <i class="bi bi-person-workspace text-info" style="font-size:1.6rem;"></i>
            </div>
            <div>
                <span class="badge bg-info text-dark mb-1" style="font-size:0.7rem; letter-spacing:1px;">MANAGER ONLY</span>
                <h1 class="h3 fw-bold mb-0">Manager Panel</h1>
                <p class="text-muted mb-0 small">Team management & oversight — restricted to Managers</p>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <div class="acxiom-card p-4 mb-4 d-flex align-items-start gap-3"
         style="border-left:3px solid #0ea5e9;">
        <i class="bi bi-check-circle-fill text-info mt-1" style="font-size:1.3rem; flex-shrink:0;"></i>
        <div>
            <h6 class="fw-bold mb-1" style="color:#7dd3fc;">Authorization Verified ✓</h6>
            <p class="text-muted mb-0 small">
                You are signed in as <strong class="text-light">@User.Identity?.Name</strong> with the
                <strong style="color:#7dd3fc;">Manager</strong> role.
                This page is correctly restricted — only Managers can see this.
            </p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var m in modules)
        {
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card h-100 opacity-50">
                    <div class="stat-icon" style="background:rgba(255,255,255,0.06);">
                        <i class="bi @m.Icon text-@m.Color"></i>
                    </div>
                    <div class="fw-semibold mb-1">@m.Title</div>
                    <div class="text-muted small mb-2">@m.Desc</div>
                    <span class="badge bg-secondary" style="font-size:0.65rem;">Phase 2</span>
                </div>
            </div>
        }
    </div>
</div>
