@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Add Customer";
    Layout = "_Layout";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Add New Customer</h1>
            <p class="text-muted small mb-0">Record a new verified customer profile into the CRM database.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Directory
        </a>
    </div>

    <div class="acxiom-card p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CustomerCode" class="form-label">Customer Code</label>
                    <input asp-for="CustomerCode" class="form-control font-monospace" readonly />
                    <span asp-validation-for="CustomerCode" class="text-danger small"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="CustomerName" class="form-label">Customer / Account Name <span class="text-danger">*</span></label>
                    <input asp-for="CustomerName" class="form-control" placeholder="e.g. Acme Corporation" required />
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="contact@company.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="+1-555-010-0000" required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="CompanyName" class="form-label">Legal Company Name</label>
                    <input asp-for="CompanyName" class="form-control" placeholder="Acme Global Inc." />
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label">Street Address</label>
                    <input asp-for="Address" class="form-control" placeholder="123 Business Parkway" />
                </div>

                <div class="col-md-6">
                    <label asp-for="City" class="form-label">City</label>
                    <input asp-for="City" class="form-control" placeholder="New York" />
                </div>

                <div class="col-md-6">
                    <label asp-for="State" class="form-label">State / Province</label>
                    <input asp-for="State" class="form-control" placeholder="NY" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label">Account Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
            </div>

            <hr class="my-4 border-secondary opacity-50" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-amber px-4">
                    <i class="bi bi-check2-circle me-1"></i>Save Customer
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
