@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Security & Audit Trail";
    Layout = "_Layout";
}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Security & Audit Trail</h1>
            <p class="text-muted small mb-0">Immutable, append-only security and business operation history log.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Admin Overview
        </a>
    </div>

    <!-- Filter Card -->
    <div class="acxiom-card p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="user" value="@ViewData["CurrentUser"]"
                       class="form-control" placeholder="Filter by User email..." />
            </div>
            <div class="col-md-3">
                <select name="action" class="form-select">
                    <option value="">All Actions</option>
                    <option value="Login" selected="@(ViewData["CurrentAction"]?.ToString() == "Login")">Login</option>
                    <option value="Failed Login" selected="@(ViewData["CurrentAction"]?.ToString() == "Failed Login")">Failed Login</option>
                    <option value="Create" selected="@(ViewData["CurrentAction"]?.ToString() == "Create")">Create</option>
                    <option value="Update" selected="@(ViewData["CurrentAction"]?.ToString() == "Update")">Update</option>
                    <option value="Delete" selected="@(ViewData["CurrentAction"]?.ToString() == "Delete")">Delete</option>
                    <option value="Lead Conversion" selected="@(ViewData["CurrentAction"]?.ToString() == "Lead Conversion")">Lead Conversion</option>
                    <option value="Security" selected="@(ViewData["CurrentAction"]?.ToString() == "Security")">Security</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="entity" class="form-select">
                    <option value="">All Entities</option>
                    <option value="Customer" selected="@(ViewData["CurrentEntity"]?.ToString() == "Customer")">Customer</option>
                    <option value="Lead" selected="@(ViewData["CurrentEntity"]?.ToString() == "Lead")">Lead</option>
                    <option value="Opportunity" selected="@(ViewData["CurrentEntity"]?.ToString() == "Opportunity")">Opportunity</option>
                    <option value="FollowUp" selected="@(ViewData["CurrentEntity"]?.ToString() == "FollowUp")">FollowUp</option>
                    <option value="User" selected="@(ViewData["CurrentEntity"]?.ToString() == "User")">User</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-outline-light w-100">Filter</button>
            </div>
            <div class="col-md-1">
                <a asp-action="AuditLogs" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>

    <!-- Audit Logs Table -->
    <div class="acxiom-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark-custom align-middle">
                <thead>
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Record ID</th>
                        <th>Details / Change</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No audit events recorded matching current filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td class="small text-muted font-monospace">@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="fw-medium text-light">@a.UserId</td>
                                <td>
                                    @if (a.Action == "Create") { <span class="badge bg-success">Create</span> }
                                    else if (a.Action == "Update") { <span class="badge bg-info text-dark">Update</span> }
                                    else if (a.Action == "Delete") { <span class="badge bg-danger">Delete</span> }
                                    else if (a.Action == "Security") { <span class="badge bg-warning text-dark">Security</span> }
                                    else { <span class="badge bg-secondary">@a.Action</span> }
                                </td>
                                <td><span class="badge bg-dark border border-secondary text-warning">@a.EntityName</span></td>
                                <td class="small font-monospace">@(a.RecordId ?? "—")</td>
                                <td class="small text-light">
                                    @if (!string.IsNullOrWhiteSpace(a.OldValue) && !string.IsNullOrWhiteSpace(a.NewValue))
                                    {
                                        <div><span class="text-muted">From:</span> @a.OldValue</div>
                                        <div><span class="text-muted">To:</span> @a.NewValue</div>
                                    }
                                    else
                                    {
                                        <span>@(a.NewValue ?? a.OldValue ?? "—")</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
