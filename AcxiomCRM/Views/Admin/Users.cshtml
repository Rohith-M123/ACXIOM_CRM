@model IEnumerable<AcxiomCRM.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "User & Role Management";
    Layout = "_Layout";
}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">User & Role Management</h1>
            <p class="text-muted small mb-0">Control application accounts, role privileges, and account security lockout states.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Admin Overview
            </a>
            <a asp-action="CreateUser" class="btn btn-amber btn-sm">
                <i class="bi bi-person-plus-fill me-1"></i>Create New User
            </a>
        </div>
    </div>

    <div class="acxiom-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark-custom align-middle">
                <thead>
                    <tr>
                        <th>Email / Username</th>
                        <th>Assigned Role</th>
                        <th>Account Status</th>
                        <th>Lockout Expiry</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-light">
                                <i class="bi bi-person-circle me-2 text-warning"></i>
                                @u.Email
                            </td>
                            <td>
                                @if (u.Role.Contains("Admin"))
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-shield-fill-check me-1"></i>Admin</span>
                                }
                                else if (u.Role.Contains("Manager"))
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-person-check me-1"></i>Manager</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-briefcase me-1"></i>Sales Executive</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger">Locked Out</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @(u.LockoutEnd.HasValue ? u.LockoutEnd.Value.ToString("g") : "None")
                            </td>
                            <td class="text-end">
                                <form asp-action="ToggleLockout" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (u.IsLockedOut)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-unlock me-1"></i>Unlock
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-lock me-1"></i>Lockout
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
