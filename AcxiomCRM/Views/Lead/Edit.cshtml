@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Edit Lead";
    Layout = "_Layout";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Edit Lead</h1>
            <p class="text-muted small mb-0">Update information for lead <span class="text-warning font-monospace">@Model.LeadCode</span></p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Details
        </a>
    </div>

    <div class="acxiom-card p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LeadId" />
            <input type="hidden" asp-for="LeadCode" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-muted">Lead Code</label>
                    <input class="form-control font-monospace" value="@Model.LeadCode" readonly disabled />
                </div>

                <div class="col-md-8">
                    <label asp-for="LeadName" class="form-label">Contact / Lead Name <span class="text-danger">*</span></label>
                    <input asp-for="LeadName" class="form-control" required />
                    <span asp-validation-for="LeadName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Source" class="form-label">Lead Source</label>
                    <select asp-for="Source" class="form-select">
                        <option value="Website">Website</option>
                        <option value="Referral">Referral</option>
                        <option value="Campaign">Campaign</option>
                        <option value="Cold Call">Cold Call</option>
                        <option value="Event / Conference">Event / Conference</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="ExpectedValue" class="form-label">Expected Value ($)</label>
                    <input asp-for="ExpectedValue" type="number" step="100" class="form-control" />
                    <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Priority" class="form-label">Priority</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="New">New</option>
                        <option value="Contacted">Contacted</option>
                        <option value="Qualified">Qualified</option>
                        <option value="Unqualified">Unqualified</option>
                        <option value="Converted">Converted</option>
                        <option value="Lost">Lost</option>
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="AssignedTo" class="form-label">Assigned Sales Executive</label>
                    <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- Unassigned --</option>
                    </select>
                </div>
            </div>

            <hr class="my-4 border-secondary opacity-50" />

            <div class="d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#lostModal">
                    <i class="bi bi-x-circle me-1"></i>Mark as Lost
                </button>

                <div class="d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-amber px-4">
                        <i class="bi bi-check2 me-1"></i>Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Mark as Lost Modal -->
<div class="modal fade" id="lostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mark Lead as Lost</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to mark lead <strong>@Model.LeadName</strong> as Lost?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.LeadId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Confirm Lost</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
