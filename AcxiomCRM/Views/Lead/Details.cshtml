@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = Model.LeadName;
    Layout = "_Layout";
}

<div class="container-fluid px-lg-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-dark border border-secondary text-warning font-monospace">@Model.LeadCode</span>
                <h1 class="h3 fw-bold mb-0">@Model.LeadName</h1>
                @if (Model.Status == "Converted") { <span class="badge bg-success">Converted</span> }
                else if (Model.Status == "Qualified") { <span class="badge bg-info text-dark">Qualified</span> }
                else if (Model.Status == "Contacted") { <span class="badge bg-primary">Contacted</span> }
                else if (Model.Status == "New") { <span class="badge bg-warning text-dark">New</span> }
                else { <span class="badge bg-secondary">@Model.Status</span> }
            </div>
            <p class="text-muted small mb-0">@(Model.CompanyName ?? "Individual Lead") &bull; Source: <span class="text-light">@Model.Source</span> &bull; Captured on @Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Directory
            </a>
            @if (Model.Status != "Converted")
            {
                <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                    <i class="bi bi-arrow-repeat me-1"></i>Convert to Customer
                </a>
            }
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-pencil me-1"></i>Edit Lead
            </a>
            <a asp-controller="FollowUp" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-info btn-sm">
                <i class="bi bi-calendar-plus me-1"></i>Schedule Follow-Up
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Profile Card -->
        <div class="col-lg-4">
            <div class="acxiom-card p-4 h-100">
                <h6 class="fw-bold text-light mb-3 pb-2 border-bottom border-secondary">
                    <i class="bi bi-info-circle text-warning me-2"></i>Lead Profile
                </h6>

                <div class="mb-3">
                    <label class="text-muted small d-block">Contact Email</label>
                    <a href="mailto:@Model.Email" class="text-info text-decoration-none fw-medium">@Model.Email</a>
                </div>

                <div class="mb-3">
                    <label class="text-muted small d-block">Phone Number</label>
                    <span class="text-light fw-medium">@Model.Phone</span>
                </div>

                <div class="mb-3">
                    <label class="text-muted small d-block">Organization</label>
                    <span class="text-light">@(Model.CompanyName ?? "—")</span>
                </div>

                <div class="mb-3">
                    <label class="text-muted small d-block">Expected Value</label>
                    <span class="h4 fw-bold text-warning mb-0">$@Model.ExpectedValue.ToString("N0")</span>
                </div>

                <div class="mb-3">
                    <label class="text-muted small d-block">Priority</label>
                    @if (Model.Priority == "High") { <span class="badge bg-danger">High Priority</span> }
                    else if (Model.Priority == "Medium") { <span class="badge bg-warning text-dark">Medium Priority</span> }
                    else { <span class="badge bg-secondary">Low Priority</span> }
                </div>

                <div class="mt-4 pt-3 border-top border-secondary small text-muted">
                    <div>Assigned Executive: <strong class="text-light">@(Model.AssignedTo ?? "Unassigned")</strong></div>
                    <div>Recorded By: <span class="text-light">@(Model.OwnerId ?? "System")</span></div>
                </div>
            </div>
        </div>

        <!-- Follow-ups & Activities Column -->
        <div class="col-lg-8">
            <div class="acxiom-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-light mb-0">
                        <i class="bi bi-calendar2-check text-info me-2"></i>Follow-Up Activities
                        <span class="badge bg-secondary ms-2">@Model.FollowUps.Count</span>
                    </h6>
                    <a asp-controller="FollowUp" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-info">
                        + Schedule Follow-Up
                    </a>
                </div>

                @if (!Model.FollowUps.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        No follow-up tasks currently assigned to this lead.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var f in Model.FollowUps.OrderByDescending(f => f.FollowUpDate))
                        {
                            <div class="list-group-item bg-transparent text-light border-secondary px-0 py-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold small">
                                        <span class="badge bg-primary me-1">@f.FollowUpType</span>
                                        @(f.Subject ?? "Lead follow-up")
                                    </div>
                                    <div class="text-muted" style="font-size: 0.78rem;">
                                        Date: <strong class="text-light">@f.FollowUpDate.ToString("MMM dd, yyyy HH:mm")</strong>
                                        @if (!string.IsNullOrWhiteSpace(f.Remarks)) { <span> &bull; @f.Remarks</span> }
                                    </div>
                                </div>
                                <span class="badge @(f.Status == "Completed" ? "bg-success" : (f.Status == "Planned" ? "bg-warning text-dark" : "bg-danger"))" style="font-size:0.7rem;">
                                    @f.Status
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (Model.Status == "Converted" && Model.ConvertedCustomerId.HasValue)
            {
                <div class="acxiom-card p-4 bg-success-subtle border-success">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-3"></i>
                        <div>
                            <h6 class="fw-bold text-success mb-1">Lead Successfully Converted</h6>
                            <p class="text-light small mb-0">This prospective lead has transitioned into an active CRM customer.</p>
                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId.Value" class="btn btn-sm btn-success mt-2">
                                View Customer Profile &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
