@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Add Lead";
    Layout = "_Layout";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Capture New Lead</h1>
            <p class="text-muted small mb-0">Record a prospective client for sales qualification and follow-up.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Leads
        </a>
    </div>

    <div class="acxiom-card p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="LeadCode" class="form-label">Lead Code</label>
                    <input asp-for="LeadCode" class="form-control font-monospace" readonly />
                </div>

                <div class="col-md-8">
                    <label asp-for="LeadName" class="form-label">Contact / Lead Name <span class="text-danger">*</span></label>
                    <input asp-for="LeadName" class="form-control" placeholder="e.g. John Doe" required />
                    <span asp-validation-for="LeadName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="+1-555-010-0000" required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" placeholder="Prospective Corp" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Source" class="form-label">Lead Source</label>
                    <select asp-for="Source" class="form-select">
                        <option value="Website">Website</option>
                        <option value="Referral">Referral</option>
                        <option value="Campaign">Campaign</option>
                        <option value="Cold Call">Cold Call</option>
                        <option value="Event / Conference">Event / Conference</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="ExpectedValue" class="form-label">Expected Value ($)</label>
                    <input asp-for="ExpectedValue" type="number" step="100" min="0" class="form-control" />
                    <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Priority" class="form-label">Priority</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="Status" class="form-label">Initial Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="New">New</option>
                        <option value="Contacted">Contacted</option>
                        <option value="Qualified">Qualified</option>
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="AssignedTo" class="form-label">Assigned Sales Executive</label>
                    <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- Assign to User --</option>
                    </select>
                </div>
            </div>

            <hr class="my-4 border-secondary opacity-50" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-amber px-4">
                    <i class="bi bi-check2 me-1"></i>Create Lead
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
