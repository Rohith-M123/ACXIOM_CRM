@model AcxiomCRM.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
    Layout = "_Layout";
}

<div class="container py-4" style="max-width: 750px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Convert Lead to Customer</h1>
            <p class="text-muted small mb-0">Graduating qualified lead <strong class="text-warning">@Model.LeadName</strong> to permanent customer status.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Cancel
        </a>
    </div>

    <div class="acxiom-card p-4">
        <form asp-action="Convert" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LeadId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

            <div class="alert alert-info d-flex align-items-center gap-2 mb-4" style="background: rgba(14, 165, 233, 0.1); border-color: rgba(14, 165, 233, 0.3);">
                <i class="bi bi-info-circle-fill text-info fs-5"></i>
                <div class="small text-light">
                    Converting will create an active <strong>Customer Account</strong> and mark this Lead as <strong>Converted</strong> in the audit history.
                </div>
            </div>

            <!-- Customer Master Data Section -->
            <h6 class="fw-bold text-light mb-3 pb-2 border-bottom border-secondary">
                <i class="bi bi-person-check text-warning me-2"></i>New Customer Account
            </h6>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="LeadName" class="form-label">Customer Name</label>
                    <input asp-for="LeadName" class="form-control" required />
                    <span asp-validation-for="LeadName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
            </div>

            <!-- Optional Opportunity Creation Section -->
            <h6 class="fw-bold text-light mb-3 pb-2 border-bottom border-secondary">
                <i class="bi bi-briefcase text-warning me-2"></i>Generate Initial Sales Opportunity
            </h6>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="oppToggle" checked />
                <label class="form-check-label text-light fw-medium" for="oppToggle">Create linked sales opportunity</label>
            </div>

            <div id="opportunityFields" class="row g-3">
                <div class="col-12">
                    <label asp-for="OpportunityName" class="form-label">Opportunity Name</label>
                    <input asp-for="OpportunityName" class="form-control" placeholder="Deal description" />
                </div>

                <div class="col-md-6">
                    <label asp-for="OpportunityAmount" class="form-label">Deal Amount ($)</label>
                    <input asp-for="OpportunityAmount" type="number" step="100" min="0" class="form-control" />
                    <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date</label>
                    <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                </div>
            </div>

            <hr class="my-4 border-secondary opacity-50" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check2-circle me-1"></i>Confirm Conversion
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const toggle = document.getElementById('oppToggle');
        const fields = document.getElementById('opportunityFields');
        if (toggle && fields) {
            toggle.addEventListener('change', function () {
                fields.style.display = this.checked ? 'flex' : 'none';
            });
        }
    </script>
}
